<?php

namespace App\Http\Controllers;

use App\Models\Bandara;
use App\Models\Inspeksi;
use App\Models\Temuan;
use Illuminate\Http\Request;

class HasilPengawasanController extends Controller
{
    /**
     * Konfigurasi halaman hasil pengawasan.
     *
     * Saat modul lain sudah siap, cukup tambahkan:
     * - pengamatan
     * - audit
     */
    private const JENIS_PENGAWASAN = [
        'pemantauan' => [
            'jenis_inspeksi' => 'Pemantauan (Monitoring)',
            'judul' => 'Hasil Pemantauan',
            'deskripsi' => 'Daftar temuan yang berasal dari kegiatan pemantauan bandar udara.',
            'label_tambah' => '+ Tambah Hasil Pemantauan',
            'route_tambah' => 'pemantauan.create',
            'view' => 'hasil-pengawasan.pemantauan',
        ],
        'pengamatan' => [
            'jenis_inspeksi' => 'Pengamatan',
            'judul' => 'Hasil Pengamatan',
            'deskripsi' => 'Daftar temuan yang berasal dari kegiatan pengamatan bandar udara.',
            'label_tambah' => '+ Tambah Hasil Pengamatan',
            'route_tambah' => 'pengamatan.create',
            'view' => 'hasil-pengawasan.pemantauan',
        ],
        'audit' => [
            'jenis_inspeksi' => 'Audit',
            'judul' => 'Hasil Audit',
            'deskripsi' => 'Daftar temuan yang berasal dari kegiatan audit bandar udara.',
            'label_tambah' => '+ Tambah Hasil Audit',
            'route_tambah' => 'audit.create',
            'view' => 'hasil-pengawasan.pemantauan',
        ],
    ];

    public function index(Request $request, string $jenis)
    {
        abort_unless(
            array_key_exists($jenis, self::JENIS_PENGAWASAN),
            404
        );

        $konfigurasi = self::JENIS_PENGAWASAN[$jenis];
        $jenisInspeksi = $konfigurasi['jenis_inspeksi'];

        /*
         * Mendukung pencarian dari:
         * - Form halaman hasil pengawasan: ?keyword=...
         * - Global Search SITBA: ?q=...
         */
        $keyword = trim((string) $request->query(
            'keyword',
            $request->query('q', '')
        ));

        $status = $request->query('status');
        $tingkatRisiko = $request->query('tingkat_risiko');

        $tahun = $request->filled('tahun')
            ? $request->integer('tahun')
            : null;

        $bandaraId = $request->filled('bandara_id')
            ? $request->integer('bandara_id')
            : null;

        $queryTemuan = Temuan::query()
            ->whereHas('inspeksi', function ($query) use ($jenisInspeksi) {
                $query->where('jenis_inspeksi', $jenisInspeksi);
            })
            ->when($keyword !== '', function ($query) use ($keyword) {
                $query->where(function ($query) use ($keyword) {
                    $query
                        ->where(
                            'nomor_temuan',
                            'like',
                            '%' . $keyword . '%'
                        )
                        ->orWhere(
                            'uraian_temuan',
                            'like',
                            '%' . $keyword . '%'
                        )
                        ->orWhere(
                            'unsur_elemen',
                            'like',
                            '%' . $keyword . '%'
                        )
                        ->orWhere(
                            'lokasi',
                            'like',
                            '%' . $keyword . '%'
                        )
                        ->orWhereHas(
                            'inspeksi.bandara',
                            function ($query) use ($keyword) {
                                $query
                                    ->where(
                                        'nama_bandara',
                                        'like',
                                        '%' . $keyword . '%'
                                    )
                                    ->orWhere(
                                        'kode_bandara',
                                        'like',
                                        '%' . $keyword . '%'
                                    );
                            }
                        );
                });
            })
            ->when($bandaraId, function ($query, $bandaraId) {
                $query->whereHas(
                    'inspeksi',
                    function ($query) use ($bandaraId) {
                        $query->where('bandara_id', $bandaraId);
                    }
                );
            })
            ->when($tahun, function ($query, $tahun) {
                $query->whereHas(
                    'inspeksi',
                    function ($query) use ($tahun) {
                        $query->whereYear('tanggal', $tahun);
                    }
                );
            })
            ->when($status, function ($query, $status) {
                $query->where('status', $status);
            })
            ->when($tingkatRisiko, function ($query, $tingkatRisiko) {
                $query->where('tingkat_risiko', $tingkatRisiko);
            });

        $totalTemuan = (clone $queryTemuan)->count();

        $totalOpen = (clone $queryTemuan)
            ->where('status', 'Open')
            ->count();

        $totalUnsatisfactory = (clone $queryTemuan)
            ->where('status', 'Unsatisfactory')
            ->count();

        $totalSatisfactory = (clone $queryTemuan)
            ->where('status', 'Satisfactory')
            ->count();

        $totalClose = (clone $queryTemuan)
            ->where('status', 'Close')
            ->count();

        $totalRisikoRendah = (clone $queryTemuan)
            ->where('tingkat_risiko', 'Rendah')
            ->count();

        $totalRisikoSedang = (clone $queryTemuan)
            ->where('tingkat_risiko', 'Sedang')
            ->count();

        $totalRisikoTinggi = (clone $queryTemuan)
            ->where('tingkat_risiko', 'Tinggi')
            ->count();

        $temuans = (clone $queryTemuan)
            ->with([
                'inspeksi.bandara',
                'foto',
                'tindakLanjut',
            ])
            ->latest()
            ->paginate(10)
            ->withQueryString();

        $daftarBandara = Bandara::query()
            ->whereHas('inspeksis', function ($query) use ($jenisInspeksi) {
                $query->where('jenis_inspeksi', $jenisInspeksi);
            })
            ->orderBy('nama_bandara')
            ->get();

        $daftarTahun = Inspeksi::query()
            ->where('jenis_inspeksi', $jenisInspeksi)
            ->whereNotNull('tanggal')
            ->selectRaw('DISTINCT strftime("%Y", tanggal) AS tahun')
            ->orderByDesc('tahun')
            ->pluck('tahun')
            ->filter()
            ->values();

        $judulHalaman = $konfigurasi['judul'];
        $deskripsiHalaman = $konfigurasi['deskripsi'];
        $labelTambah = $konfigurasi['label_tambah'];
        $routeTambah = $konfigurasi['route_tambah'];

        return view($konfigurasi['view'], compact(
            'temuans',
            'daftarBandara',
            'daftarTahun',
            'totalTemuan',
            'totalOpen',
            'totalUnsatisfactory',
            'totalSatisfactory',
            'totalClose',
            'totalRisikoRendah',
            'totalRisikoSedang',
            'totalRisikoTinggi',
            'judulHalaman',
            'deskripsiHalaman',
            'labelTambah',
            'routeTambah'
        ));
    }
}
