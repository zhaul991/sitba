<?php

namespace App\Http\Controllers;

use App\Models\Bandara;
use App\Models\Inspeksi;
use App\Models\Laporan;
use App\Models\Temuan;
use Illuminate\Http\Request;

class GlobalSearchController extends Controller
{
    public function __invoke(Request $request)
    {
        $keyword = trim((string) $request->query('q', ''));

        if ($keyword === '') {
            return response()->json([
                'bandara' => [],
                'inspeksi' => [],
                'temuan' => [],
                'laporan' => [],
            ]);
        }

        $bandara = Bandara::query()
            ->where(function ($query) use ($keyword) {
                $query
                    ->where('nama_bandara', 'like', "%{$keyword}%")
                    ->orWhere('kode_bandara', 'like', "%{$keyword}%");
            })
            ->limit(5)
            ->get()
            ->map(function (Bandara $bandara) {
                return [
                    'id' => $bandara->id,
                    'judul' => $bandara->nama_bandara,
                    'keterangan' => $bandara->kode_bandara ?: 'Bandara',
                    'url' => route('bandara.show', $bandara),
                ];
            });

        $inspeksi = Inspeksi::query()
            ->with('bandara')
            ->where(function ($query) use ($keyword) {
                $query
                    ->where('nomor_inspeksi', 'like', "%{$keyword}%")
                    ->orWhereHas('bandara', function ($bandaraQuery) use ($keyword) {
                        $bandaraQuery
                            ->where('nama_bandara', 'like', "%{$keyword}%")
                            ->orWhere('kode_bandara', 'like', "%{$keyword}%");
                    });
            })
            ->limit(5)
            ->get()
            ->map(function (Inspeksi $inspeksi) {
                return [
                    'id' => $inspeksi->id,
                    'judul' => $inspeksi->nomor_inspeksi,
                    'keterangan' => $inspeksi->bandara?->nama_bandara
                        ?? 'Bandara tidak tersedia',
                    'url' => route('inspeksi.show', $inspeksi),
                ];
            });

        $temuan = Temuan::query()
            ->with('inspeksi.bandara')
            ->where(function ($query) use ($keyword) {
                $query
                    ->where('nomor_temuan', 'like', "%{$keyword}%")
                    ->orWhere('uraian_temuan', 'like', "%{$keyword}%")
                    ->orWhereHas(
                        'inspeksi.bandara',
                        function ($bandaraQuery) use ($keyword) {
                            $bandaraQuery
                                ->where('nama_bandara', 'like', "%{$keyword}%")
                                ->orWhere('kode_bandara', 'like', "%{$keyword}%");
                        }
                    );
            })
            ->limit(5)
            ->get()
            ->map(function (Temuan $temuan) {
                return [
                    'id' => $temuan->id,
                    'judul' => $temuan->nomor_temuan,
                    'keterangan' => $temuan->inspeksi?->bandara?->nama_bandara
                        ?? 'Bandara tidak tersedia',
                    'url' => route('temuan.show', $temuan),
                ];
            });

        $laporan = Laporan::query()
            ->with('bandara')
            ->where(function ($query) use ($keyword) {
                $query
                    ->where('nomor_surat', 'like', "%{$keyword}%")
                    ->orWhere('perihal', 'like', "%{$keyword}%")
                    ->orWhereHas('bandara', function ($bandaraQuery) use ($keyword) {
                        $bandaraQuery
                            ->where('nama_bandara', 'like', "%{$keyword}%")
                            ->orWhere('kode_bandara', 'like', "%{$keyword}%");
                    });
            })
            ->limit(5)
            ->get()
            ->map(function (Laporan $laporan) {
                return [
                    'id' => $laporan->id,
                    'judul' => $laporan->nomor_surat,
                    'keterangan' => $laporan->bandara?->nama_bandara
                        ?? $laporan->perihal
                        ?? 'Laporan',
                    'url' => route('laporan.show', $laporan),
                ];
            });

        return response()->json([
            'bandara' => $bandara,
            'inspeksi' => $inspeksi,
            'temuan' => $temuan,
            'laporan' => $laporan,
        ]);
    }
}
