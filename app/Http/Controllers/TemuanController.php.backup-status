<?php

namespace App\Http\Controllers;

use App\Models\Inspeksi;
use App\Models\Temuan;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;

class TemuanController extends Controller
{
    public function index(Request $request)
    {
        $keyword = $request->keyword;
        $status = $request->status;
        $tingkatRisiko = $request->tingkat_risiko;

        $temuans = Temuan::with([
                'inspeksi.bandara',
                'foto',
                'tindakLanjut',
            ])
            ->when($keyword, function ($query, $keyword) {
                $query->where(function ($query) use ($keyword) {
                    $query->where('nomor_temuan', 'like', '%' . $keyword . '%')
                        ->orWhere('uraian_temuan', 'like', '%' . $keyword . '%')
                        ->orWhere('unsur_elemen', 'like', '%' . $keyword . '%')
                        ->orWhere('lokasi', 'like', '%' . $keyword . '%')
                        ->orWhereHas('inspeksi.bandara', function ($query) use ($keyword) {
                            $query->where('nama_bandara', 'like', '%' . $keyword . '%')
                                ->orWhere('kode_bandara', 'like', '%' . $keyword . '%');
                        });
                });
            })
            ->when($status, function ($query, $status) {
                $query->where('status', $status);
            })
            ->when($tingkatRisiko, function ($query, $tingkatRisiko) {
                $query->where('tingkat_risiko', $tingkatRisiko);
            })
            ->latest()
            ->paginate(10)
            ->withQueryString();

        return view('temuan.index', compact('temuans'));
    }

    public function create(Request $request)
    {
        $inspeksis = Inspeksi::with('bandara')
            ->latest('tanggal')
            ->get();

        $inspeksiTerpilih = $request->inspeksi_id;

        return view('temuan.create', compact(
            'inspeksis',
            'inspeksiTerpilih'
        ));
    }

    public function store(Request $request)
    {
        $validated = $request->validate([
            'inspeksi_id' => ['required', 'exists:inspeksis,id'],
            'nomor_temuan' => [
                'required',
                'string',
                'max:255',
                'unique:temuans,nomor_temuan',
            ],
            'uraian_temuan' => ['required', 'string'],
            'unsur_elemen' => ['required', 'string', 'max:255'],
            'tingkat_risiko' => [
                'required',
                Rule::in(['Rendah', 'Sedang', 'Tinggi', 'Ekstrem']),
            ],
            'lokasi' => ['required', 'string', 'max:255'],
            'status' => [
                'required',
                Rule::in([
                    'Open',
                    'Dalam Tindak Lanjut',
                    'Selesai',
                ]),
            ],
        ], [
            'inspeksi_id.required' => 'Data inspeksi wajib dipilih.',
            'inspeksi_id.exists' => 'Data inspeksi yang dipilih tidak valid.',
            'nomor_temuan.required' => 'Nomor temuan wajib diisi.',
            'nomor_temuan.unique' => 'Nomor temuan sudah digunakan.',
            'uraian_temuan.required' => 'Uraian temuan wajib diisi.',
            'unsur_elemen.required' => 'Unsur atau elemen wajib diisi.',
            'tingkat_risiko.required' => 'Tingkat risiko wajib dipilih.',
            'tingkat_risiko.in' => 'Tingkat risiko tidak valid.',
            'lokasi.required' => 'Lokasi temuan wajib diisi.',
        ]);

        $validated['status'] = 'Open';

        $temuan = Temuan::create($validated);

        return redirect()
            ->route('temuan.show', $temuan)
            ->with('success', 'Data temuan berhasil ditambahkan.');
    }

    public function show(Temuan $temuan)
    {
        $temuan->load([
            'inspeksi.bandara',
            'inspeksi.petugas',
            'foto',
            'tindakLanjut',
        ]);

        return view('temuan.show', compact('temuan'));
    }

    public function edit(Temuan $temuan)
    {
        $inspeksis = Inspeksi::with('bandara')
            ->latest('tanggal')
            ->get();

        return view('temuan.edit', compact(
            'temuan',
            'inspeksis'
        ));
    }

    public function update(Request $request, Temuan $temuan)
    {
        $validated = $request->validate([
            'inspeksi_id' => ['required', 'exists:inspeksis,id'],
            'nomor_temuan' => [
                'required',
                'string',
                'max:255',
                Rule::unique('temuans', 'nomor_temuan')->ignore($temuan->id),
            ],
            'uraian_temuan' => ['required', 'string'],
            'unsur_elemen' => ['required', 'string', 'max:255'],
            'tingkat_risiko' => [
                'required',
                Rule::in(['Rendah', 'Sedang', 'Tinggi', 'Ekstrem']),
            ],
            'lokasi' => ['required', 'string', 'max:255'],
            'status' => [
                'required',
                Rule::in([
                    'Open',
                    'Dalam Tindak Lanjut',
                    'Selesai',
                ]),
            ],
        ]);

        unset($validated['status']);

        $temuan->update($validated);

        return redirect()
            ->route('temuan.show', $temuan)
            ->with('success', 'Data temuan berhasil diperbarui.');
    }

    public function destroy(Temuan $temuan)
    {
        $inspeksiId = $temuan->inspeksi_id;

        $temuan->delete();

        return redirect()
            ->route('inspeksi.show', $inspeksiId)
            ->with('success', 'Data temuan berhasil dihapus.');
    }
}
